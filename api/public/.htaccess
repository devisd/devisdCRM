# Devis Studio CRM API — routing for /api/* only.
#
# Deploy this file together with index.php into <document root>/api/.
# It affects only this directory, so frontend routes are never rewritten.
# RewriteBase assumes the API is served at https://<domain>/api/.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L,QSA]
</IfModule>
